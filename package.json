{
  "name": "openleaf",
  "productName": "Verso",
  "version": "1.0.0",
  "description": "Local, offline-first desktop LaTeX editor",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Leonard",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/LeoB914/verso#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeoB914/verso.git"
  },
  "bugs": {
    "url": "https://github.com/LeoB914/verso/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/copy-dictionaries.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "screenshots": "electron-vite build && node scripts/screenshot.mjs",
    "verify:templates": "node scripts/verify-templates.mjs",
    "docs:shortcuts": "node scripts/generate-shortcuts.mjs",
    "icons": "electron-vite build && node scripts/generate-icons.mjs",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.73",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0",
    "@replit/codemirror-vim": "^6.4.0",
    "ai": "^7.0.145",
    "chokidar": "^6.0.0",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "electron-store": "^12.0.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.59.0",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.6",
    "simple-git": "^4.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "png2icons": "^2.0.1",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
