<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Allow JIT for V8 and unsigned memory for the GPU process. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allow spawning the user's TeX toolchain (latexmk, biber, …). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Network: DOI/arXiv/ISBN imports and Ollama / AI providers. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- User-selected files and the open project folder. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
